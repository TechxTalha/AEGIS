# --- Spring Active Profile ---
SPRING_PROFILES_ACTIVE=local

# --- Database Configuration ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/aegis?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=aegis_user
SPRING_DATASOURCE_PASSWORD=aegis_pass

# --- Backend Configuration ---
JWT_SECRET=super_secret_jwt_key_that_should_be_at_least_256_bits_long_for_hs256_algorithm
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
SERVER_PORT=8080

# --- Master Encryption Key ---
AEGIS_SECRET_KEY=dev-master-encryption-key-32-bytes-long

# --- CORS Allowed Origins ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Multi-Model Gateway & Fallback Cascade ---
AEGIS_MODEL_PRIMARY_PROVIDER=openai
AEGIS_MODEL_PRIMARY_ENDPOINT=https://api.openai.com/v1
AEGIS_MODEL_PRIMARY_API_KEY=
AEGIS_MODEL_PRIMARY_NAME=gpt-4o

AEGIS_MODEL_FALLBACK1_PROVIDER=groq
AEGIS_MODEL_FALLBACK1_ENDPOINT=https://api.groq.com/openai/v1
AEGIS_MODEL_FALLBACK1_API_KEY=
AEGIS_MODEL_FALLBACK1_NAME=llama-3.3-70b-versatile

AEGIS_MODEL_FALLBACK2_PROVIDER=gemini
AEGIS_MODEL_FALLBACK2_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
AEGIS_MODEL_FALLBACK2_API_KEY=
AEGIS_MODEL_FALLBACK2_NAME=gemini-1.5-flash

AEGIS_MODEL_FALLBACK3_PROVIDER=openrouter
AEGIS_MODEL_FALLBACK3_ENDPOINT=https://openrouter.ai/api/v1
AEGIS_MODEL_FALLBACK3_API_KEY=
AEGIS_MODEL_FALLBACK3_NAME=meta-llama/llama-3.1-8b-instruct:free

# --- Frontend Configuration ---
VITE_API_URL=http://localhost:8080/api
