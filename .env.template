# AEGIS Environment Variables Template
# Copy this file to .env and configure the values for your environment.

# --- Database Configuration ---
# The JDBC URL for the MySQL database.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/aegis?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# The database user.
SPRING_DATASOURCE_USERNAME=aegis_user
# The database password (MUST BE SECURED IN PRODUCTION).
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# --- JWT Configuration ---
# The secret key used for signing JWTs. Must be at least 256 bits for HS256.
JWT_SECRET=your_super_secret_jwt_key_that_is_long_enough
# Token expiration time in milliseconds (default: 15 minutes = 900000)
JWT_EXPIRATION_MS=900000
# Refresh token expiration time in milliseconds (default: 7 days = 604800000)
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Model Gateway ---
# The primary model provider API key (e.g., OpenAI, Anthropic, local LM Studio).
AEGIS_MODEL_API_KEY=your_model_api_key_here
# The endpoint for the model provider.
AEGIS_MODEL_ENDPOINT=https://api.openai.com/v1
# The exact model name to use.
AEGIS_MODEL_NAME=gpt-4o

# --- Server Configuration ---
# The port the backend will run on.
SERVER_PORT=8080
