# AEGIS Environment Variables Template
# Copy this file to .env and configure the values for your environment.

# --- Spring Active Profile ---
# Options: 'local' (development/testing) or 'prod' (production server)
SPRING_PROFILES_ACTIVE=prod

# --- Database Configuration ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/aegis?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=aegis_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# --- JWT Configuration ---
# Secret key used for signing JWTs. Must be at least 256 bits (32+ chars) for HS256.
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long_for_security
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Master Encryption Key ---
AEGIS_SECRET_KEY=your_secure_master_encryption_key_here

# --- CORS Allowed Origins ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =========================================================================
# --- Multi-Model Gateway & Resilient Fallback Cascade ---
# If a free-tier model runs out of credits or hits a rate limit (HTTP 429),
# the gateway automatically and silently cascades to the next available provider.
# =========================================================================

# Primary Model (e.g., OpenAI or fast Groq)
AEGIS_MODEL_PRIMARY_PROVIDER=openai
AEGIS_MODEL_PRIMARY_ENDPOINT=https://api.openai.com/v1
AEGIS_MODEL_PRIMARY_API_KEY=your_primary_api_key_here
AEGIS_MODEL_PRIMARY_NAME=gpt-4o

# Fallback Tier 1 (e.g., Groq free tier - fast inference)
AEGIS_MODEL_FALLBACK1_PROVIDER=groq
AEGIS_MODEL_FALLBACK1_ENDPOINT=https://api.groq.com/openai/v1
AEGIS_MODEL_FALLBACK1_API_KEY=your_groq_api_key_here
AEGIS_MODEL_FALLBACK1_NAME=llama-3.3-70b-versatile

# Fallback Tier 2 (e.g., Google Gemini 1.5/2.0 Flash free tier via OpenAI endpoint)
AEGIS_MODEL_FALLBACK2_PROVIDER=gemini
AEGIS_MODEL_FALLBACK2_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
AEGIS_MODEL_FALLBACK2_API_KEY=your_gemini_api_key_here
AEGIS_MODEL_FALLBACK2_NAME=gemini-1.5-flash

# Fallback Tier 3 (e.g., OpenRouter free models / Mistral / DeepSeek)
AEGIS_MODEL_FALLBACK3_PROVIDER=openrouter
AEGIS_MODEL_FALLBACK3_ENDPOINT=https://openrouter.ai/api/v1
AEGIS_MODEL_FALLBACK3_API_KEY=your_openrouter_api_key_here
AEGIS_MODEL_FALLBACK3_NAME=meta-llama/llama-3.1-8b-instruct:free

# --- Server Configuration ---
SERVER_PORT=8080
